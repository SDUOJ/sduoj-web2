  "scripts": {
    "start": "cross-env NODE_ENV=development webpack serve --config config/webpack.config.js --port 3000",
    "build": "cross-env NODE_ENV=production PUBLIC_URL=/v2/ webpack --config config/webpack.config.js && node scripts/release-artifact.cjs create build",
    "build:pre": "cross-env NODE_ENV=production PUBLIC_URL=/v2-pre/ webpack --config config/webpack.config.js && node scripts/patch-build-prefix.cjs /v2-pre && node scripts/release-artifact.cjs create build /v2-pre/",
    "build:test": "cross-env NODE_ENV=production PUBLIC_URL=/v2/ BUILD_PATH=build-test REACT_APP_DEPLOYMENT_ENV=test REACT_APP_API_ORIGIN=http://127.0.0.1:4173 REACT_APP_FRONT_ORIGIN=http://127.0.0.1:4173 REACT_APP_SOCKET_ORIGIN=ws://127.0.0.1:4173 webpack --config config/webpack.config.js && node scripts/release-artifact.cjs create build-test /v2/",
    "artifact:verify": "node scripts/release-artifact.cjs verify",
    "test:artifact": "node --test scripts/release-artifact.test.cjs",
    "test:vditor-assets": "node --test scripts/vditor-assets.test.cjs",
    "test:timeouts": "node --test scripts/timed-command.test.cjs",
    "test:static": "node --test scripts/check-static.test.cjs && node scripts/check-workflow-pins.test.cjs",
    "lint:static": "node scripts/check-static.cjs",
    "bundle:check": "node scripts/check-initial-bundle.cjs",
    "test": "jest",
    "test:unit": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:e2e": "yarn build:test && playwright test",
    "test:local": "playwright test -c playwright.local.config.ts",
    "test:issues": "playwright test -c playwright.issues.config.ts",
    "test:dev-regression": "playwright test -c playwright.dev-regression.config.ts",
    "validation:snapshot": "node scripts/snapshot-validation-schema.cjs",
    "validation:compile": "node scripts/compile-autolab-validators.cjs",
    "validation:check": "node scripts/compile-autolab-validators.cjs --check",
    "test:security-unit": "node --test scripts/security-*.test.cjs scripts/compile-autolab-validators.test.cjs",
    "test:release-recovery": "node --test scripts/release-recovery.test.cjs",
    "test:deployment-smoke": "node --test scripts/deployment-smoke.test.cjs",
    "test:security": "yarn build:test && cross-env SDUOJ_SECURITY_REAL_SERVICES=1 playwright test -c playwright.security.config.ts",
    "test:visual": "yarn build:test && cross-env VISUAL_REGRESSION=1 playwright test --project chromium --project mobile-chromium --grep visual",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "lint": "node scripts/lint.cjs",
    "lint:report": "eslint src --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.cjs",
    "quality": "yarn format:check && yarn validation:check && yarn typecheck && yarn lint && yarn test:coverage",
    "verify": "yarn quality && yarn build && yarn test:e2e"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
